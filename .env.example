# Copy this file to .env.development or .env.production and fill in the values

# Backend selection: 'supabase' or 'express'
VITE_API_BACKEND=supabase

# Supabase configuration (required when VITE_API_BACKEND=supabase)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Express API configuration (required when VITE_API_BACKEND=express)
VITE_API_BASE_URL=https://api.example.com/inventory
